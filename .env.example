# ScoutSphere Environment Variables Configuration Template
# Copy this file to .env before running docker compose up or local development.

# Environment Mode
ENVIRONMENT=development
LOG_LEVEL=INFO

# PostgreSQL 17 + pgvector Database Setup
POSTGRES_USER=scoutsphere
POSTGRES_PASSWORD=scoutsphere_dev_pass
POSTGRES_DB=scoutsphere_db
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://scoutsphere:scoutsphere_dev_pass@db:5432/scoutsphere_db

# Redis Setup (Celery + Caching)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# JWT & Authentication Setup
JWT_SECRET=super_secret_jwt_key_change_in_production_32bytes_min
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# LLM Client Provider Fallback Chain ($0 Free Tier First)
# Supported options: gemini, groq, openrouter, ollama
LLM_PROVIDER_CHAIN=gemini,groq,openrouter,ollama

# Provider API Keys (Fill with real free keys or leave empty for stubs/mocks)
GEMINI_API_KEY=your_free_gemini_api_key_here
GROQ_API_KEY=your_free_groq_api_key_here
OPENROUTER_API_KEY=your_free_openrouter_api_key_here
OLLAMA_BASE_URL=http://localhost:11434

# Embeddings Configuration (SentenceTransformers running locally or Gemini free embedding endpoint)
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# Opportunity Discovery Scraper API Keys / Mock Settings
OPPORTUNITY_SOURCE_API_KEYS={}

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000/api/v1
